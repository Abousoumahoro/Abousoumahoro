# Copiez ce fichier en « .env » et remplissez les valeurs. Ne le partagez jamais.

# Votre nom de domaine pour l'API (ex : api.livraison-ventes.ci), sans https://
DOMAINE=api.votre-domaine.com

# Secret des sessions : une longue phrase aléatoire (ex : résultat de « openssl rand -hex 32 »)
JWT_SECRET=

# --- Wave Business (laisser vide = simulation) ---
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# --- Orange Money Web Payment (laisser vide = simulation) ---
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
# ORANGE_CURRENCY=OUV   # environnement de test Orange
